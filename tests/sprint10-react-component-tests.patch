+import { screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, it, expect } from 'vitest'
+import SignUp from '../SignUp'
+import { renderPage, mockFetch, jsonResponse, STORAGE_KEY } from '../../test/utils'
+
+const submit = (user) => user.click(screen.getByRole('button', { name: 'Create Account' }))
+
+const fillRequired = async (user, { name = 'Jane Doe', email = 'jane@example.com', password = 'secret123' } = {}) => {
+  if (name) await user.type(screen.getByPlaceholderText('Jane Doe'), name)
+  if (email) await user.type(screen.getByPlaceholderText('you@example.com'), email)
+  if (password) await user.type(screen.getByPlaceholderText('••••••••'), password)
+}
+
+describe('SignUp', () => {
+  it('renders the form with default household size and diet', () => {
+    renderPage(<SignUp />)
+    expect(screen.getByRole('heading', { name: 'Create Account' })).toBeInTheDocument()
+    expect(screen.getByRole('spinbutton')).toHaveValue(1)
+    expect(screen.getByRole('combobox')).toHaveValue('None')
+  })
+
+  it('shows a validation error and does not call the API when required fields are empty', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderPage(<SignUp />)
+
+    await submit(user)
+
+    expect(screen.getByText('Please fill out all required fields')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('treats a whitespace-only name as missing', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderPage(<SignUp />)
+
+    await fillRequired(user, { name: '   ' })
+    await submit(user)
+
+    expect(screen.getByText('Please fill out all required fields')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('creates the account, stores the user, and navigates to /profile on success', async () => {
+    const returnedUser = { id: 7, name: 'Jane Doe', email: 'jane@example.com', household: 3, diet: 'Vegan' }
+    const fetchMock = mockFetch(jsonResponse(returnedUser))
+    const user = userEvent.setup()
+    renderPage(<SignUp />)
+
+    await fillRequired(user)
+    const household = screen.getByRole('spinbutton')
+    await user.clear(household)
+    await user.type(household, '3')
+    await user.selectOptions(screen.getByRole('combobox'), 'Vegan')
+    await submit(user)
+
+    expect(await screen.findByText('Profile Page')).toBeInTheDocument()
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    const [url, options] = fetchMock.mock.calls[0]
+    expect(url).toBe('/api/signup')
+    expect(options.method).toBe('POST')
+    expect(JSON.parse(options.body)).toEqual({
+      name: 'Jane Doe',
+      email: 'jane@example.com',
+      password: 'secret123',
+      household: 3,
+      diet: 'Vegan',
+    })
+    expect(JSON.parse(localStorage.getItem(STORAGE_KEY))).toEqual(returnedUser)
+  })
+
+  it('shows the server error message when sign up fails', async () => {
+    mockFetch(jsonResponse({ error: 'Email already registered' }, { ok: false, status: 409 }))
+    const user = userEvent.setup()
+    renderPage(<SignUp />)
+
+    await fillRequired(user)
+    await submit(user)
+
+    expect(await screen.findByText('Email already registered')).toBeInTheDocument()
+    expect(screen.queryByText('Profile Page')).not.toBeInTheDocument()
+  })
+})
