+import { render } from '@testing-library/react'
+import { MemoryRouter, Routes, Route } from 'react-router-dom'
+import { vi } from 'vitest'
+import { UserProvider } from '../UserContext'
+
+export const STORAGE_KEY = 'pantryplus_current_user'
+
+/**
+ * Render a page inside the real UserProvider and a MemoryRouter.
+ * Extra routes render a simple marker so tests can assert navigation.
+ */
+export function renderPage(ui, { route = '/', path = '/', user = null } = {}) {
+  if (user) {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(user))
+  }
+
+  return render(
+    <UserProvider>
+      <MemoryRouter initialEntries={[route]}>
+        <Routes>
+          <Route path={path} element={ui} />
+          <Route path="/profile" element={<div>Profile Page</div>} />
+          <Route path="/login" element={<div>Login Page</div>} />
+          <Route path="/signup" element={<div>Sign Up Page</div>} />
+        </Routes>
+      </MemoryRouter>
+    </UserProvider>
+  )
+}
+
+/** Build a minimal fetch Response-like object. */
+export function jsonResponse(body, { ok = true, status = 200 } = {}) {
+  return { ok, status, json: async () => body }
+}
+
+/** Replace global fetch with a mock that resolves to the given responses in order. */
+export function mockFetch(...responses) {
+  const fn = vi.fn()
+  responses.forEach((r) => fn.mockResolvedValueOnce(r))
+  vi.stubGlobal('fetch', fn)
+  return fn
+}
