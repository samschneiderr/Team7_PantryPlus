diff --git a/frontend/src/pages/__tests__/Add.test.jsx b/frontend/src/pages/__tests__/Add.test.jsx
new file mode 100644
index 0000000..52ae69e
--- /dev/null
+++ b/frontend/src/pages/__tests__/Add.test.jsx
@@ -0,0 +1,130 @@
+import { screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, it, expect } from 'vitest'
+import Add from '../Add'
+import { renderPage, mockFetch, jsonResponse } from '../../test/utils'
+
+const loggedInUser = { id: 42, name: 'Sam', email: 'sam@example.com' }
+
+const renderAdd = (opts = {}) => renderPage(<Add />, { user: loggedInUser, route: '/add', path: '/add', ...opts })
+
+const nameInput = () => screen.getByPlaceholderText('Peanut Butter')
+const quantityInput = () => screen.getByPlaceholderText('1')
+const submit = (user) => user.click(screen.getByRole('button', { name: 'Add Item' }))
+
+describe('Add', () => {
+  it('prompts the user to log in when nobody is logged in', async () => {
+    const user = userEvent.setup()
+    renderPage(<Add />, { route: '/add', path: '/add' })
+
+    expect(screen.getByText("You're not logged in yet")).toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Go to Login' }))
+    expect(screen.getByText('Login Page')).toBeInTheDocument()
+  })
+
+  it('shows required-field errors and does not call the API when the form is empty', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderAdd()
+
+    await screen.findByPlaceholderText('Peanut Butter')
+    await submit(user)
+
+    expect(screen.getByText('Name is required')).toBeInTheDocument()
+    expect(screen.getByText('Quantity must be above 0')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('rejects a quantity of 0', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderAdd()
+
+    await user.type(await screen.findByPlaceholderText('Peanut Butter'), 'Milk')
+    await user.type(quantityInput(), '0')
+    await submit(user)
+
+    expect(screen.queryByText('Name is required')).not.toBeInTheDocument()
+    expect(screen.getByText('Quantity must be above 0')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('submits the item, clears the form, and shows a success toast', async () => {
+    const fetchMock = mockFetch(jsonResponse({ id: 1 }))
+    const user = userEvent.setup()
+    renderAdd()
+
+    await user.type(await screen.findByPlaceholderText('Peanut Butter'), 'Milk')
+    await user.type(quantityInput(), '2')
+    await user.type(screen.getByPlaceholderText('jar, lb, carton...'), 'carton')
+    await user.type(screen.getByPlaceholderText('Pantry, Dairy, Produce...'), 'Dairy')
+    await submit(user)
+
+    expect(await screen.findByText('✓ Log successful')).toBeInTheDocument()
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    const [url, options] = fetchMock.mock.calls[0]
+    expect(url).toBe('/api/items')
+    expect(options.method).toBe('POST')
+    expect(JSON.parse(options.body)).toEqual({
+      name: 'Milk',
+      quantity: 2,
+      unit: 'carton',
+      category: 'Dairy',
+      expiration_date: null,
+      user_id: 42,
+    })
+    expect(nameInput()).toHaveValue('')
+    expect(quantityInput()).toHaveValue(null)
+  })
+
+  it('shows the server error message when the API rejects the item', async () => {
+    mockFetch(jsonResponse({ error: 'Item already exists' }, { ok: false, status: 400 }))
+    const user = userEvent.setup()
+    renderAdd()
+
+    await user.type(await screen.findByPlaceholderText('Peanut Butter'), 'Milk')
+    await user.type(quantityInput(), '1')
+    await submit(user)
+
+    expect(await screen.findByText('Item already exists')).toBeInTheDocument()
+    expect(screen.queryByText('✓ Log successful')).not.toBeInTheDocument()
+    expect(nameInput()).toHaveValue('Milk')
+  })
+
+  it('shows a connection error when the server cannot be reached', async () => {
+    const fetchMock = mockFetch()
+    fetchMock.mockRejectedValueOnce(new TypeError('Failed to fetch'))
+    const user = userEvent.setup()
+    renderAdd()
+
+    await user.type(await screen.findByPlaceholderText('Peanut Butter'), 'Milk')
+    await user.type(quantityInput(), '1')
+    await submit(user)
+
+    expect(await screen.findByText('Could not reach the server. Is it running?')).toBeInTheDocument()
+  })
+
+  it('prefills the form from a successful barcode scan', async () => {
+    // The scan effect re-runs once the logged-in user is restored from localStorage,
+    // so answer every call with the same scan result.
+    const fetchMock = mockFetch()
+    fetchMock.mockResolvedValue(jsonResponse({ success: true, item_name: 'Peanut Butter', category: 'Pantry' }))
+    renderAdd({ route: '/add?barcode=0123456789' })
+
+    expect(await screen.findByText(/Recognized: Peanut Butter/)).toBeInTheDocument()
+    expect(nameInput()).toHaveValue('Peanut Butter')
+    expect(quantityInput()).toHaveValue(1)
+    const [url, options] = fetchMock.mock.calls.at(-1)
+    expect(url).toBe('/api/scan')
+    expect(JSON.parse(options.body)).toMatchObject({ barcode: '0123456789', user_id: 42 })
+  })
+
+  it('tells the user to enter the item manually when the scan fails', async () => {
+    const fetchMock = mockFetch()
+    fetchMock.mockResolvedValue(jsonResponse({ success: false }))
+    renderAdd({ route: '/add?barcode=000' })
+
+    expect(await screen.findByText('Scan unsuccessful. Please enter the item manually.')).toBeInTheDocument()
+    expect(nameInput()).toHaveValue('')
+  })
+})
diff --git a/frontend/src/pages/__tests__/Login.test.jsx b/frontend/src/pages/__tests__/Login.test.jsx
new file mode 100644
index 0000000..ee8468e
--- /dev/null
+++ b/frontend/src/pages/__tests__/Login.test.jsx
@@ -0,0 +1,71 @@
+import { screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, it, expect } from 'vitest'
+import Login from '../Login'
+import { renderPage, mockFetch, jsonResponse, STORAGE_KEY } from '../../test/utils'
+
+const fillAndSubmit = async (user, { email, password }) => {
+  if (email) await user.type(screen.getByPlaceholderText('you@example.com'), email)
+  if (password) await user.type(screen.getByPlaceholderText('••••••••'), password)
+  await user.click(screen.getByRole('button', { name: 'Log In' }))
+}
+
+describe('Login', () => {
+  it('renders the email and password fields', () => {
+    renderPage(<Login />)
+    expect(screen.getByRole('heading', { name: 'Log In' })).toBeInTheDocument()
+    expect(screen.getByPlaceholderText('you@example.com')).toBeInTheDocument()
+    expect(screen.getByPlaceholderText('••••••••')).toBeInTheDocument()
+  })
+
+  it('shows a validation error and does not call the API when fields are empty', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderPage(<Login />)
+
+    await fillAndSubmit(user, {})
+
+    expect(screen.getByText('Please enter both email and password')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('shows a validation error when the password is missing', async () => {
+    const fetchMock = mockFetch()
+    const user = userEvent.setup()
+    renderPage(<Login />)
+
+    await fillAndSubmit(user, { email: 'sam@example.com' })
+
+    expect(screen.getByText('Please enter both email and password')).toBeInTheDocument()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('logs in, stores the user, and navigates to /profile on success', async () => {
+    const returnedUser = { id: 1, name: 'Sam', email: 'sam@example.com' }
+    const fetchMock = mockFetch(jsonResponse(returnedUser))
+    const user = userEvent.setup()
+    renderPage(<Login />)
+
+    await fillAndSubmit(user, { email: 'sam@example.com', password: 'secret123' })
+
+    expect(await screen.findByText('Profile Page')).toBeInTheDocument()
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    const [url, options] = fetchMock.mock.calls[0]
+    expect(url).toBe('/api/login')
+    expect(options.method).toBe('POST')
+    expect(JSON.parse(options.body)).toEqual({ email: 'sam@example.com', password: 'secret123' })
+    expect(JSON.parse(localStorage.getItem(STORAGE_KEY))).toEqual(returnedUser)
+  })
+
+  it('shows the server error message and stays on the page when login fails', async () => {
+    mockFetch(jsonResponse({ error: 'Invalid email or password' }, { ok: false, status: 401 }))
+    const user = userEvent.setup()
+    renderPage(<Login />)
+
+    await fillAndSubmit(user, { email: 'sam@example.com', password: 'wrong' })
+
+    expect(await screen.findByText('Invalid email or password')).toBeInTheDocument()
+    expect(screen.queryByText('Profile Page')).not.toBeInTheDocument()
+    expect(localStorage.getItem(STORAGE_KEY)).toBeNull()
+  })
+})
